# PostgreSQL (Supabase Direct URL with Connection Pooling)
SUPABASE_POSTGRES_DIRECT_URL=postgresql://postgres.xxx:password@aws-0-region.pooler.supabase.com:6543/postgres

# Multimodal LLM Provider & Vision Models (OpenAI or Gemini)
# Provider choices: "openai" (uses GPT-4o vision) or "gemini" (uses Gemini 1.5/2.0 vision)
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# USDA FoodData Central API Key
USDA_API_KEY=your_usda_api_key_here

# Supabase Auth / JWT Verification
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# LangSmith / LangChain Tracing
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_PROJECT=bite-backend

# Application Configuration
APP_ENV=development
LOG_LEVEL=INFO
